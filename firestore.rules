rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection document for initial boot check
    match /test/connection {
      allow read: if true;
    }

    // User profile collection
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 128;
      allow update: if isOwner(userId)
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;

      // User pipelines collection
      match /pipelines/{pipelineId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId)
          && isValidId(pipelineId)
          && incoming().userId == request.auth.uid
          && incoming().nama is string && incoming().nama.size() > 0 && incoming().nama.size() <= 100
          && incoming().limit is number && incoming().limit > 0
          && incoming().tenor is number && incoming().tenor > 0
          && incoming().produk in ['KUM', 'KUR', 'Kawan Lawa'];
        
        allow update: if isOwner(userId)
          && incoming().userId == existing().userId
          && incoming().nama is string && incoming().nama.size() > 0 && incoming().nama.size() <= 100
          && incoming().limit is number && incoming().limit > 0
          && incoming().tenor is number && incoming().tenor > 0;
          
        allow delete: if isOwner(userId);
      }

      // User memos collection
      match /memos/{memoId} {
        allow get, list: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidId(memoId)
          && incoming().userId == request.auth.uid
          && incoming().namaNsbh is string && incoming().namaNsbh.size() <= 100;
        allow delete: if isOwner(userId);
      }
    }
  }
}
