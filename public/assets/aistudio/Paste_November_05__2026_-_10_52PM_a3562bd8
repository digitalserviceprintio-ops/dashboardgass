                            <td className="py-2 px-3 font-semibold">{formatRp(row.angsuran)}</td>
                            <td className="py-2 px-3 text-slate-600">{formatRp(row.pokok)}</td>
                            <td className="py-2 px-3 text-amber-700">{formatRp(row.bunga)}</td>
                            <td className="py-2 px-3 font-medium">{formatRp(row.sisaPokok)}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </div>

              </div>
            </div>
          </div>
        )}

