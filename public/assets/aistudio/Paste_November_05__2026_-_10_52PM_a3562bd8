  };

  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 flex flex-col font-sans">
      
      {/* Navigation Bar - Clean White Theme */}
      <header className="bg-white text-slate-800 sticky top-0 z-30 shadow-sm border-b border-slate-200">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex items-center justify-between h-16">
            
            {/* Logo */}
            <div className="flex items-center space-x-3">
              <div className="bg-blue-600 p-2 rounded-xl text-white shadow-sm">
                <Building2 className="w-6 h-6" />
              </div>
              <div>
                <h1 className="font-bold text-lg leading-tight tracking-tight text-slate-900">FinDashboard PRD</h1>
                <p className="text-xs text-slate-500">Brosur Suku Bunga & Analytics Pipeline</p>
              </div>
            </div>

            {/* Desktop Navigation */}
            <nav className="hidden md:flex space-x-2">
              <button
                onClick={() => setActiveTab('pipeline')}
                className={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-150 ${
                  activeTab === 'pipeline'
                    ? 'bg-blue-50 text-blue-700 border border-blue-200/80 shadow-sm'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
                }`}
              >
                <BarChart3 className="w-4 h-4" />
                <span>Dashboard Analytics & Pipeline</span>
                <span className="bg-blue-100 text-blue-700 text-xs px-2 py-0.5 rounded-full font-bold">
                  {pipelines.length}
                </span>
              </button>

              <button
                onClick={() => setActiveTab('calculator')}
                className={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-150 ${
                  activeTab === 'calculator'
                    ? 'bg-blue-50 text-blue-700 border border-blue-200/80 shadow-sm'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
                }`}
              >
                <Calculator className="w-4 h-4" />
                <span>Kalkulator & Brosur Bunga</span>
              </button>

              <button
                onClick={() => setActiveTab('memo')}
                className={`flex items-center space-x-2 px-4 py-2 rounded-xl text-sm font-semibold transition-all duration-150 ${
                  activeTab === 'memo'
                    ? 'bg-blue-50 text-blue-700 border border-blue-200/80 shadow-sm'
                    : 'text-slate-600 hover:bg-slate-100 hover:text-slate-900'
                }`}
              >
                <FileText className="w-4 h-4" />
                <span>Memo & Calculation Debitur</span>
              </button>
            </nav>

            {/* Mobile Menu Button */}
            <div className="md:hidden">
              <button
                onClick={() => setMobileMenuOpen(!mobileMenuOpen)}
                className="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none"
              >
                {mobileMenuOpen ? <X className="w-6 h-6" /> : <Menu className="w-6 h-6" />}
              </button>
            </div>
          </div>
        </div>

        {/* Mobile Dropdown Menu */}
        {mobileMenuOpen && (
          <div className="md:hidden bg-white border-t border-slate-200 px-4 pt-2 pb-4 space-y-2">
            <button
              onClick={() => { setActiveTab('pipeline'); setMobileMenuOpen(false); }}
              className={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-base font-medium ${
                activeTab === 'pipeline' ? 'bg-blue-50 text-blue-700 font-bold' : 'text-slate-600 hover:bg-slate-100'
              }`}
            >
              <div className="flex items-center space-x-3">
                <BarChart3 className="w-5 h-5" />
                <span>Analytics & Pipeline</span>
              </div>
              <span className="bg-blue-100 text-blue-700 text-xs px-2 py-0.5 rounded-full font-bold">
                {pipelines.length}
              </span>
            </button>
            <button
              onClick={() => { setActiveTab('calculator'); setMobileMenuOpen(false); }}
              className={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-base font-medium ${
                activeTab === 'calculator' ? 'bg-blue-50 text-blue-700 font-bold' : 'text-slate-600 hover:bg-slate-100'
              }`}
            >
              <div className="flex items-center space-x-3">
                <Calculator className="w-5 h-5" />
                <span>Kalkulator & Brosur Bunga</span>
              </div>
            </button>
            <button
              onClick={() => { setActiveTab('memo'); setMobileMenuOpen(false); }}
              className={`w-full flex items-center justify-between px-3 py-2.5 rounded-lg text-base font-medium ${
                activeTab === 'memo' ? 'bg-blue-50 text-blue-700 font-bold' : 'text-slate-600 hover:bg-slate-100'
              }`}
            >
              <div className="flex items-center space-x-3">
                <FileText className="w-5 h-5" />
                <span>Memo & Calculation Debitur</span>
              </div>
            </button>
          </div>
        )}
      </header>

      {/* Main Container */}
      <main className="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-8">

        {/* ========================================================================= */}
        {/* TAB 1: DASHBOARD PIPELINE & GRAFIK TREN ANALITIK                         */}
        {/* ========================================================================= */}
        {activeTab === 'pipeline' && (
          <div className="space-y-8">
            {/* Header Title & Actions */}
            <div className="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
              <div>
                <h2 className="text-2xl font-bold text-slate-900 tracking-tight">Dashboard Pipeline & Analitik</h2>
                <p className="text-sm text-slate-500">Visualisasi tren pengajuan pinjaman, produk (KUM, KUR, Kawan Lawa), dan manajemen prospek</p>
              </div>
              
              <div className="flex items-center space-x-3">
                <div className="relative">
                  <button
                    onClick={() => setShowShareDropdown(!showShareDropdown)}
                    className="inline-flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white px-4 py-2.5 rounded-xl font-semibold shadow-sm transition-all"
                  >
                    <Share2 className="w-4 h-4" />
                    <span>Bagikan All Data</span>
                    <ChevronDown className="w-4 h-4" />
                  </button>

                  {showShareDropdown && (
                    <div className="absolute right-0 mt-2 w-56 bg-white rounded-2xl shadow-xl border border-slate-200 py-2 z-50">
                      <button
                        onClick={handleShareAllWhatsApp}
                        className="w-full flex items-center space-x-3 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-emerald-50 hover:text-emerald-700"
                      >
                        <MessageCircle className="w-4 h-4 text-emerald-600" />
                        <span>Kirim Ringkasan WA</span>
                      </button>
                      <button
                        onClick={handleCopyAllToClipboard}
                        className="w-full flex items-center space-x-3 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-blue-50 hover:text-blue-700"
                      >
                        <Copy className="w-4 h-4 text-blue-600" />
                        <span>Salin Semua Data</span>
                      </button>
                      <button
                        onClick={handleDownloadCSV}
                        className="w-full flex items-center space-x-3 px-4 py-2.5 text-xs font-semibold text-slate-700 hover:bg-purple-50 hover:text-purple-700"
                      >
                        <Download className="w-4 h-4 text-purple-600" />
                        <span>Unduh File CSV / Excel</span>
                      </button>
                    </div>
                  )}
                </div>

                <button
                  onClick={handleOpenModal}
                  className="inline-flex items-center justify-center space-x-2 bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-semibold shadow-sm transition-all hover:scale-[1.01] active:scale-95"
                >
                  <Plus className="w-5 h-5" />
                  <span>Tambah Aplikasi</span>
                </button>
              </div>
            </div>

            {/* Top KPI Cards Row */}
            <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div className="p-3.5 bg-blue-50 text-blue-600 rounded-xl">
                  <Users className="w-6 h-6" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Prospek</p>
                  <h3 className="text-2xl font-bold text-slate-900 mt-0.5">{totalProspects} Aplikasi</h3>
                </div>
              </div>

              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div className="p-3.5 bg-indigo-50 text-indigo-600 rounded-xl">
                  <DollarSign className="w-6 h-6" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-500 uppercase tracking-wider">Total Limit Plafon</p>
                  <h3 className="text-xl font-bold text-slate-900 mt-0.5">{formatRp(totalLimit)}</h3>
                </div>
              </div>

              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div className="p-3.5 bg-emerald-50 text-emerald-600 rounded-xl">
                  <Activity className="w-6 h-6" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-500 uppercase tracking-wider">Capaian Target MPS</p>
                  <h3 className="text-2xl font-bold text-emerald-600 mt-0.5">{mpsAchievementPercent}%</h3>
                </div>
              </div>

              <div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4">
                <div className="p-3.5 bg-purple-50 text-purple-600 rounded-xl">
                  <TrendingUp className="w-6 h-6" />
                </div>
                <div>
                  <p className="text-xs font-semibold text-slate-500 uppercase tracking-wider">Rata-Rata Limit</p>
                  <h3 className="text-xl font-bold text-slate-900 mt-0.5">{formatRp(avgLimit)}</h3>
                </div>
              </div>
            </div>

            {/* TARGET MPS & PODIUM GRADE INTEGRATED SECTION */}
            <div className="bg-white text-slate-900 rounded-2xl p-6 shadow-sm border border-slate-200">
              <div className="flex flex-col lg:flex-row lg:items-center justify-between gap-6">
                <div className="space-y-3 lg:max-w-md">
                  <div className="flex items-center space-x-2">
                    <span className="bg-amber-100 text-amber-800 text-xs font-bold px-2.5 py-1 rounded-md border border-amber-300 uppercase tracking-wider">
                      WAJIB MPS: Rp 1,2 MILYAR
                    </span>
                    <span className="text-xs text-slate-500">| Target Podium</span>
                  </div>
                  <h3 className="text-xl font-bold text-slate-900 flex items-center space-x-2">
                    <Activity className="w-5 h-5 text-blue-600" />
                    <span>Target Podium & Monitoring MPS</span>
                  </h3>
                  <p className="text-xs text-slate-600 leading-relaxed">
                    Pilih skema Podium untuk target minimal produk KUM. Sisa plafon dapat dipenuhi dari KUR (bebas) atau produk lain hingga mencapai **Wajib MPS Rp 1,2 Milyar**.
                  </p>

                  <div className="pt-2 flex flex-wrap items-center gap-2">
                    {['Podium A', 'Podium B'].map((g) => (
                      <button
                        key={g}
                        onClick={() => setSelectedGrade(g)}
                        className={`px-4 py-2 rounded-xl text-xs font-bold transition-all border flex items-center space-x-1.5 ${
                          selectedGrade === g
                            ? 'bg-blue-600 text-white border-blue-600 shadow-sm scale-105'
                            : 'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100'
                        }`}
                      >
                        <span>🏆 {g}</span>
                        <span className="text-[10px] opacity-80">({g === 'Podium A' ? 'KUM 750 Jt' : 'KUM 400 Jt'})</span>
                      </button>
                    ))}
                  </div>

                  <p className="text-[11px] text-amber-800 font-medium italic pt-1">
                    * Ketentuan: {currentPodium.desc}
                  </p>

                  {Number(kumAchievementPercent) >= 100 ? (
                    <div className="mt-3 bg-emerald-50 border border-emerald-300 p-3 rounded-xl flex items-center space-x-3 text-emerald-800">
                      <CheckCircle className="w-5 h-5 flex-shrink-0 text-emerald-600" />
                      <div className="text-xs">
                        <p className="font-bold">🎉 TARGET KUM {selectedGrade.toUpperCase()} TERCAPAI! ({kumAchievementPercent}%)</p>
                        <p className="text-[11px] text-emerald-700 mt-0.5">
                          Realisasi KUM saat ini {formatRp(realKumNominal)} dari target {formatRp(currentPodium.targetKum)}.
                        </p>
                      </div>
                    </div>
                  ) : (
                    <div className="mt-3 bg-blue-50 border border-blue-200 p-2.5 rounded-xl flex items-center space-x-2.5 text-blue-900">
                      <Clock className="w-4 h-4 flex-shrink-0 text-blue-600" />
                      <div className="text-[11px]">
                        <span>Progres KUM {selectedGrade}: <strong className="text-blue-950 font-bold">{kumAchievementPercent}%</strong> (Kurang {formatRp(sisaTargetKum)})</span>
                      </div>
                    </div>
                  )}
                </div>

                <div className="flex-1 bg-slate-50 border border-slate-200 p-5 rounded-xl space-y-4">
                  <div className="flex flex-col sm:flex-row justify-between items-start sm:items-end gap-2 border-b border-slate-200 pb-3">
                    <div>
                      <span className="text-xs text-slate-500 font-medium block">Total Pipeline Pencairan</span>
                      <span className="text-2xl font-black text-blue-900">{formatRp(totalLimit)}</span>
                    </div>
                    <div className="text-left sm:text-right">
                      <span className="text-xs text-slate-500 font-medium block">Target Wajib MPS</span>
                      <span className="text-xl font-bold text-amber-700">{formatRp(WAJIB_MPS_TARGET)}</span>
                    </div>
                  </div>

                  <div>
                    <div className="flex justify-between text-xs mb-1.5 font-semibold">
                      <span className="text-slate-700">Target Wajib MPS (Rp 1.2 M)</span>
                      <span className={Number(mpsAchievementPercent) >= 100 ? 'text-emerald-600 font-bold' : 'text-blue-700 font-bold'}>
                        {mpsAchievementPercent}% {Number(mpsAchievementPercent) >= 100 ? '🏆 MPS TERCAPAI!' : ''}
                      </span>
                    </div>
                    <div className="w-full bg-slate-200 h-3.5 rounded-full overflow-hidden p-0.5 border border-slate-300">
                      <div
                        className={`h-full rounded-full transition-all duration-500 ${
                          Number(mpsAchievementPercent) >= 100 
                            ? 'bg-emerald-500' 
                            : 'bg-blue-600'
                        }`}
                        style={{ width: `${Math.min(100, Number(mpsAchievementPercent))}%` }}
                      ></div>
                    </div>
                    <span className="text-[11px] text-slate-500 block mt-1">
                      Sisa Kekurangan MPS: <strong className="text-slate-800">{sisaTargetMps > 0 ? formatRp(sisaTargetMps) : 'Lunas'}</strong>
                    </span>
                  </div>

                  <div className="pt-1 border-t border-slate-200">
                    <div className="flex justify-between text-xs mb-1 font-semibold">
                      <span className="text-slate-700 flex items-center space-x-1">
                        <span>Target KUM ({selectedGrade}: {formatRp(currentPodium.targetKum)})</span>
                        {Number(kumAchievementPercent) >= 100 && (
                          <span className="bg-emerald-100 text-emerald-800 border border-emerald-300 text-[10px] font-extrabold px-1.5 py-0.2 rounded">TERCAPAI</span>
                        )}
                      </span>
                      <span className={Number(kumAchievementPercent) >= 100 ? 'text-emerald-700 font-bold' : 'text-blue-700 font-bold'}>
                        {formatRp(realKumNominal)} / {kumAchievementPercent}%
                      </span>
                    </div>
                    <div className="w-full bg-slate-200 h-2.5 rounded-full overflow-hidden p-0.5 border border-slate-300">
                      <div
                        className={`h-full rounded-full transition-all duration-500 ${
                          Number(kumAchievementPercent) >= 100
                            ? 'bg-emerald-500'
                            : 'bg-indigo-600'
                        }`}
                        style={{ width: `${Math.min(100, Number(kumAchievementPercent))}%` }}
                      ></div>
                    </div>
                    <div className="flex justify-between items-center text-[11px] text-slate-500 mt-1">
                      <span>
                        Status Target KUM:{' '}
                        {Number(kumAchievementPercent) >= 100 ? (
                          <strong className="text-emerald-700 font-bold">✓ Terpenuhi ({kumAchievementPercent}%)</strong>
                        ) : (
                          <strong className="text-slate-800 font-semibold">Sisa {formatRp(sisaTargetKum)} ({kumAchievementPercent}%)</strong>
                        )}
                      </span>
                      <span className="text-emerald-700 font-semibold">KUR (Bebas): {formatRp(realKurNominal)}</span>
                    </div>
                  </div>

                </div>
              </div>
            </div>

            {/* ANALYTICS CHARTS SECTION */}
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
              <div className="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div>
                  <div className="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                    <h3 className="font-bold text-slate-900 flex items-center space-x-2">
                      <PieChartIcon className="w-5 h-5 text-indigo-600" />
                      <span>Distribusi Catatan Progres</span>
                    </h3>
                    <span className="text-xs bg-slate-100 text-slate-600 px-2 py-1 rounded-md font-semibold">
                      Real-time %
                    </span>
                  </div>
                  <p className="text-xs text-slate-500 mb-2">Persentase pengelompokan catatan status pengajuan nasabah</p>
                </div>

                <div className="h-64 relative w-full flex items-center justify-center">
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={statusDistributionData}
                        cx="50%"
                        cy="50%"
                        innerRadius={55}
                        outerRadius={80}
                        paddingAngle={4}
                        dataKey="value"
                      >
                        {statusDistributionData.map((entry) => (
                          <Cell key={`cell-${entry.name}`} fill={entry.color} />
                        ))}
                      </Pie>
                      <Tooltip 
                        formatter={(val, name) => [
                          `${val} Aplikasi`,
                          String(name)
                        ]}
                      />
                    </PieChart>
                  </ResponsiveContainer>
                  
                  <div className="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                    <span className="text-2xl font-black text-slate-800">{totalProspects}</span>
                    <span className="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Aplikasi</span>
                  </div>
                </div>

                <div className="max-h-36 overflow-y-auto space-y-2 pt-3 border-t border-slate-100 pr-1">
                  {statusDistributionData.map((item) => (
                    <div key={item.name} className="flex items-center justify-between p-2 bg-slate-50 rounded-xl border border-slate-100">
                      <div className="flex items-center space-x-2 overflow-hidden mr-2">
                        <span className="w-2.5 h-2.5 rounded-full flex-shrink-0" style={{ backgroundColor: item.color }}></span>
                        <span className="text-xs font-medium text-slate-700 truncate">{item.name}</span>
                      </div>
                      <span className="text-xs font-bold text-slate-900 flex-shrink-0">{item.percentage}%</span>
                    </div>
                  ))}
                </div>
              </div>

              <div className="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div>
                  <div className="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
                    <h3 className="font-bold text-slate-900 flex items-center space-x-2">
                      <BarChart3 className="w-5 h-5 text-blue-600" />
                      <span>Volume Limit & Porsi Produk</span>
                    </h3>
                    <span className="text-xs text-blue-700 font-semibold bg-blue-50 px-2 py-1 rounded-md border border-blue-100">
                      Dalam Juta (Rp)
                    </span>
                  </div>
                  <p className="text-xs text-slate-500 mb-2">Volume nominal plafon pinjaman yang diajukan per bulan</p>
                </div>

                <div className="h-56 w-full">
                  <ResponsiveContainer width="100%" height="100%">
                    <BarChart data={monthlyTrendData} margin={{ top: 10, right: 10, left: -10, bottom: 0 }}>
                      <XAxis dataKey="bulan" tickLine={false} tick={{ fontSize: 12, fill: '#64748b' }} />
                      <YAxis tickLine={false} tick={{ fontSize: 12, fill: '#64748b' }} />
                      <Tooltip 
                        formatter={(value) => [`Rp ${value} Juta`, 'Volume Limit']}
                        contentStyle={{ borderRadius: '12px', border: '1px solid #e2e8f0', boxShadow: '0 4px 6px -1px rgba(0,0,0,0.05)' }}
                      />
                      <Legend wrapperStyle={{ fontSize: '12px', paddingTop: '10px' }} />
                      <Bar dataKey="TotalLimit" name="Volume Limit Pengajuan" fill="#3b82f6" radius={[6, 6, 0, 0]} />
                    </BarChart>
                  </ResponsiveContainer>
                </div>

                <div className="pt-4 border-t border-slate-100">
                  <span className="text-xs font-semibold text-slate-500 uppercase tracking-wider block mb-2">Porsi Produk Pinjaman</span>
                  <div className="grid grid-cols-3 gap-3 text-center">
                    {productDistributionData.map((prod) => (
                      <div key={prod.name} className="bg-slate-50 p-2.5 rounded-xl border border-slate-200">
                        <span className="text-[11px] text-slate-600 font-bold block">{prod.name}</span>
                        <div className="flex items-center justify-center space-x-1 mt-0.5">
                          <span className="text-sm font-extrabold text-blue-900">{prod.count}</span>
                          <span className="text-[10px] text-slate-500">({prod.percentage}%)</span>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            </div>

            {/* TABEL PIPELINE DATA */}
            <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
              <div className="p-5 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4 bg-slate-50/50">
                <div className="flex items-center space-x-3">
                  <h3 className="font-bold text-slate-900">Data Pipeline Nasabah</h3>
                  <span className="bg-slate-200 text-slate-700 text-xs px-2.5 py-1 rounded-full font-semibold">
                    {filteredPipelines.length} Data
                  </span>
                </div>

                <div className="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                  <div className="relative">
                    <Search className="w-4 h-4 absolute left-3 top-1/2 -translate-y-1/2 text-slate-400" />
                    <input
                      type="text"
                      placeholder="Cari nama, usaha, status..."
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      className="pl-9 pr-4 py-2 bg-white border border-slate-300 rounded-xl text-xs focus:ring-2 focus:ring-blue-500 font-medium w-full sm:w-56"
                    />
                  </div>

                  <div className="flex items-center space-x-2">
                    <Filter className="w-4 h-4 text-slate-400" />
                    <select
                      value={filterProduk}
                      onChange={(e) => setFilterProduk(e.target.value)}
                      className="py-2 px-3 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-slate-700"
                    >
                      <option value="All">Semua Produk</option>
                      <option value="KUM">KUM</option>
                      <option value="KUR">KUR</option>
                      <option value="Kawan Lawa">Kawan Lawa</option>
                    </select>
                  </div>
                </div>
              </div>

              <div className="overflow-x-auto">
                <table className="w-full text-left text-xs text-slate-600">
                  <thead className="bg-slate-100/70 text-slate-700 uppercase font-bold border-b border-slate-200">
                    <tr>
                      <th className="py-3.5 px-4">No</th>
                      <th className="py-3.5 px-4">Nama Nasabah</th>
                      <th className="py-3.5 px-4">Produk</th>
                      <th className="py-3.5 px-4">Jenis Usaha / Alamat</th>
                      <th className="py-3.5 px-4">Limit Pinjaman</th>
                      <th className="py-3.5 px-4">Tenor</th>
