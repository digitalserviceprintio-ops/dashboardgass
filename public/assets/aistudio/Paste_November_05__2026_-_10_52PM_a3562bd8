                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-mono"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Sumber Booking</label>
                    <input
                      type="text"
                      value={memoData.sumberBooking}
                      onChange={(e) => setMemoData({ ...memoData, sumberBooking: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Limit Pinjaman (Rp)</label>
                    <div className="relative">
                      <input
                        type="text"
                        value={formattedInputs.limit}
                        onChange={(e) => handleFormattedInputChange('limit', e.target.value)}
                        className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-blue-900"
                        placeholder="misal: 100.000.000"
                      />
                    </div>
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Tenor (Bulan)</label>
                    <input
                      type="number"
                      value={memoData.tenor}
                      onChange={(e) => setMemoData({ ...memoData, tenor: Number(e.target.value) })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Angsuran per Bulan (Rp)</label>
                    <div className="relative">
                      <input
                        type="text"
                        value={formattedInputs.angsuranPerBulan}
                        onChange={(e) => handleFormattedInputChange('angsuranPerBulan', e.target.value)}
                        className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-blue-900"
                        placeholder="misal: 950.000"
                      />
                    </div>
                  </div>
                </div>

                {/* Sub Section: Perhitungan Usaha & DBR */}
                <div className="bg-slate-50 p-4 rounded-xl border border-slate-200 space-y-4">
                  <h4 className="text-xs font-bold text-slate-800 uppercase tracking-wider flex items-center justify-between">
                    <span className="flex items-center space-x-1.5">
                      <Calculator className="w-4 h-4 text-emerald-600" />
                      <span>Perhitungan Usaha & DBR (Max 35%)</span>
                    </span>
                    {memoCalculations.isDbrExceeded && (
                      <span className="text-[10px] font-bold text-rose-600 bg-rose-100 px-2 py-0.5 rounded border border-rose-200">
                        OVER DBR LIMIT
                      </span>
                    )}
                  </h4>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <label className="block text-xs font-semibold text-slate-600 mb-1">Pendapatan Kotor / Bulan (Rp)</label>
                      <input
                        type="text"
                        value={formattedInputs.pendapatanKotor}
                        onChange={(e) => handleFormattedInputChange('pendapatanKotor', e.target.value)}
                        className="w-full p-2.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold"
                        placeholder="misal: 15.000.000"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-semibold text-slate-600 mb-1">Total Biaya Usaha / Bln (Rp)</label>
                      <input
                        type="text"
                        value={formattedInputs.biayaUsaha}
                        onChange={(e) => handleFormattedInputChange('biayaUsaha', e.target.value)}
                        className="w-full p-2.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold"
                        placeholder="misal: 600.000"
                      />
                    </div>
                  </div>

                  {/* Calculated Stats Cards */}
                  <div className="grid grid-cols-2 gap-3 pt-2">
