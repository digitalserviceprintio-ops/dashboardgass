                      <tr>
                        <td colSpan="9" className="py-8 text-center text-slate-400 font-medium">
                          Tidak ada data pipeline yang sesuai.
                        </td>
                      </tr>
                    )}
                  </tbody>
                </table>
              </div>
            </div>

          </div>
        )}

        {/* ========================================================================= */}
        {/* TAB 2: KALKULATOR PRD BROSUR SUKU BUNGA                                  */}
        {/* ========================================================================= */}
