              <div>
                <h2 className="text-2xl font-bold text-slate-900 tracking-tight">Memo & Perhitungan Usaha Debitur</h2>
                <p className="text-sm text-slate-500">Form pengisian terstruktur & kalkulator DBR (Maksimal 35%) untuk pengajuan approval komite</p>
              </div>

              <div className="flex items-center space-x-2">
                <button
                  onClick={handleLoadSampleMemo}
                  className="inline-flex items-center space-x-2 bg-slate-100 hover:bg-slate-200 text-slate-700 px-3.5 py-2 rounded-xl text-xs font-semibold border border-slate-300 transition-all"
                >
                  <Sparkles className="w-4 h-4 text-amber-500" />
                  <span>Isi Contoh Data (Jiono)</span>
                </button>
              </div>
            </div>

            {/* Split Form & Preview Memo Grid */}
            <div className="grid grid-cols-1 lg:grid-cols-12 gap-6">
              
              {/* Form Input Section */}
              <div className="lg:col-span-7 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm space-y-6">
                
                {/* Header Sub section */}
                <div className="border-b border-slate-200 pb-3 flex items-center justify-between">
                  <h3 className="text-base font-bold text-slate-900 flex items-center space-x-2">
                    <FileText className="w-5 h-5 text-blue-600" />
                    <span>Input Data Memo Approval</span>
                  </h3>
                  <span className={`text-xs px-2.5 py-1 rounded-full font-bold border ${
                    memoCalculations.isDbrExceeded 
                      ? 'bg-rose-50 text-rose-700 border-rose-300' 
                      : 'bg-blue-50 text-blue-700 border-blue-200'
                  }`}>
                    Max DBR 35%
                  </span>
                </div>

                {/* WARNING BANNER JIKA DBR > 35% */}
                {memoCalculations.isDbrExceeded && (
                  <div className="bg-rose-50 border-2 border-rose-300 p-4 rounded-xl flex items-start space-x-3 text-rose-900 animate-pulse">
                    <AlertTriangle className="w-6 h-6 text-rose-600 flex-shrink-0 mt-0.5" />
                    <div className="text-xs">
                      <p className="font-bold text-sm text-rose-700">⚠️ PERINGATAN: DBR MELEBIHI KETENTUAN (35%)</p>
                      <p className="mt-1 leading-relaxed">
                        Hasil kalkulasi DBR saat ini adalah <strong>{memoCalculations.dbrPercent}%</strong> (Batas maksimal aman: <strong>35.00%</strong>). 
                        Silakan atur kembali limit, tenor, atau angsuran debitur agar memenuhi kriteria komite.
                      </p>
                    </div>
                  </div>
                )}

                <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Tujuan Kepada (Penerima Memo)</label>
                    <input
                      type="text"
                      value={memoData.penerima}
                      onChange={(e) => setMemoData({ ...memoData, penerima: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Unit / Cabang</label>
                    <input
                      type="text"
                      value={memoData.unit}
                      onChange={(e) => setMemoData({ ...memoData, unit: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Nama SGP / AO</label>
                    <input
                      type="text"
                      value={memoData.namaSgp}
                      onChange={(e) => setMemoData({ ...memoData, namaSgp: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Nama Nasabah</label>
                    <input
                      type="text"
                      value={memoData.namaNsbh}
                      onChange={(e) => setMemoData({ ...memoData, namaNsbh: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-slate-900"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Produk Pinjaman</label>
                    <select
                      value={memoData.produk}
                      onChange={(e) => setMemoData({ ...memoData, produk: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-bold text-slate-900"
                    >
                      <option value="KUR">KUR</option>
                      <option value="KUM">KUM</option>
                      <option value="Kawan Lawa">Kawan Lawa</option>
                    </select>
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">No Aplikasi</label>
                    <input
                      type="text"
                      value={memoData.noAplikasi}
