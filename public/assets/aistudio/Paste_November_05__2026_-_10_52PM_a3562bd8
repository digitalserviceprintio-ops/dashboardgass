          <div className="space-y-6">
            <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div>
                <h2 className="text-2xl font-bold text-slate-900 tracking-tight">Kalkulator Brosur Suku Bunga</h2>
                <p className="text-sm text-slate-500">Konversi Suku Bunga Efektif per Produk (KUM, KUR, Kawan Lawa) ke Suku Bunga Flat Equivalent</p>
              </div>
              <button
                onClick={() => setShowBrosurModal(true)}
                className="inline-flex items-center justify-center space-x-2 bg-emerald-600 hover:bg-emerald-700 text-white px-5 py-2.5 rounded-xl font-medium shadow-sm transition-all hover:scale-[1.01] active:scale-95"
