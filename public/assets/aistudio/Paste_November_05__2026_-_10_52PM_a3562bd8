                        <tr key={item.id} className="hover:bg-slate-50 transition-colors">
                          <td className="py-3.5 px-4 font-semibold text-slate-500">{index + 1}</td>
                          <td className="py-3.5 px-4 font-bold text-slate-900">{item.nama}</td>
                          <td className="py-3.5 px-4">
                            <span className={`px-2.5 py-1 rounded-full text-[10px] font-bold border ${
                              item.produk === 'KUR' 
                                ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
                                : item.produk === 'KUM'
                                ? 'bg-blue-50 text-blue-700 border-blue-200'
                                : 'bg-purple-50 text-purple-700 border-purple-200'
                            }`}>
                              {item.produk}
                            </span>
                          </td>
                          <td className="py-3.5 px-4 max-w-xs">
                            <div className="font-semibold text-slate-800">{item.usaha}</div>
                            <div className="text-[11px] text-slate-400 truncate">{item.alamat}</div>
                          </td>
                          <td className="py-3.5 px-4 font-bold text-slate-900">{formatRp(item.limit)}</td>
                          <td className="py-3.5 px-4 font-medium">{item.tenor} Bln</td>
                          <td className="py-3.5 px-4">
                            <span className="px-2.5 py-1 rounded-lg text-[11px] font-semibold bg-slate-100 text-slate-700 border border-slate-200 inline-block max-w-[180px] truncate">
                              {item.status || '-'}
                            </span>
                          </td>
                          <td className="py-3.5 px-4 text-center">
                            <button
                              onClick={() => handleShareWhatsApp(item)}
                              title="Bagikan Ke WhatsApp"
                              className="inline-flex items-center space-x-1 bg-emerald-50 hover:bg-emerald-600 text-emerald-700 hover:text-white px-2.5 py-1.5 rounded-lg border border-emerald-200 transition-all font-semibold text-[11px]"
