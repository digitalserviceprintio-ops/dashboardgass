                      onChange={(e) => setMemoData({ ...memoData, usaha: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Tujuan Pinjaman</label>
                    <input
                      type="text"
                      value={memoData.tujuan}
                      onChange={(e) => setMemoData({ ...memoData, tujuan: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Alamat Nasabah</label>
                    <input
                      type="text"
                      value={memoData.alamat}
                      onChange={(e) => setMemoData({ ...memoData, alamat: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Agunan</label>
                    <textarea
                      rows="2"
                      value={memoData.agunan}
                      onChange={(e) => setMemoData({ ...memoData, agunan: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    ></textarea>
                  </div>

                  <div className="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <label className="block text-xs font-semibold text-slate-600 mb-1">Hasil Ideb Debitur</label>
                      <input
                        type="text"
                        value={memoData.idebDebitur}
                        onChange={(e) => setMemoData({ ...memoData, idebDebitur: e.target.value })}
                        className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-semibold text-slate-600 mb-1">Hasil Ideb Pasangan</label>
                      <input
                        type="text"
                        value={memoData.idebPasangan}
                        onChange={(e) => setMemoData({ ...memoData, idebPasangan: e.target.value })}
                        className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-semibold text-slate-600 mb-1">Asuransi Jiwa</label>
                      <input
                        type="text"
                        value={memoData.asuransiJiwa}
                        onChange={(e) => setMemoData({ ...memoData, asuransiJiwa: e.target.value })}
                        className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                      />
                    </div>

                    <div>
                      <label className="block text-xs font-semibold text-slate-600 mb-1">Asuransi Kerugian</label>
                      <input
                        type="text"
                        value={memoData.asuransiKerugian}
                        onChange={(e) => setMemoData({ ...memoData, asuransiKerugian: e.target.value })}
                        className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                        placeholder="Jika ada"
                      />
                    </div>
                  </div>

                  <div>
                    <label className="block text-xs font-semibold text-slate-600 mb-1">Team OTS</label>
                    <input
                      type="text"
                      value={memoData.teamOts}
                      onChange={(e) => setMemoData({ ...memoData, teamOts: e.target.value })}
                      className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl text-xs font-semibold"
                    />
                  </div>
                </div>

              </div>

              {/* Preview Memo Result Section */}
              <div className="lg:col-span-5 bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col justify-between">
                <div>
                  <div className="border-b border-slate-200 pb-3 mb-4 flex items-center justify-between">
                    <h3 className="text-base font-bold text-slate-900 flex items-center space-x-2">
                      <Send className="w-5 h-5 text-emerald-600" />
                      <span>Preview Format Teks Memo</span>
                    </h3>
                    <span className="text-xs bg-emerald-50 text-emerald-700 px-2 py-0.5 rounded font-bold border border-emerald-200">
                      Ready to Send
                    </span>
                  </div>

                  {/* Message Container Text Box */}
                  <div className="bg-slate-900 text-slate-100 p-4 rounded-xl font-mono text-xs leading-relaxed whitespace-pre-wrap max-h-[600px] overflow-y-auto border border-slate-800 shadow-inner">
                    {formattedMemoText}
                  </div>
                </div>

                {/* Action Buttons */}
                <div className="pt-6 space-y-3">
                  <button
                    onClick={handleSendMemoWhatsApp}
                    className="w-full bg-emerald-600 hover:bg-emerald-700 text-white py-3 rounded-xl font-bold flex items-center justify-center space-x-2 shadow-sm transition-all"
                  >
                    <MessageCircle className="w-5 h-5" />
                    <span>Kirim Memo via WhatsApp</span>
                  </button>

                  <div className="grid grid-cols-2 gap-3">
                    <button
                      onClick={handleCopyMemo}
                      className="w-full bg-slate-100 hover:bg-slate-200 text-slate-700 py-2.5 rounded-xl font-semibold flex items-center justify-center space-x-2 border border-slate-300 transition-all text-xs"
                    >
                      <Copy className="w-4 h-4" />
                      <span>Salin Teks Memo</span>
                    </button>

                    <button
                      onClick={handleDownloadMemoFile}
                      className="w-full bg-blue-50 hover:bg-blue-100 text-blue-700 py-2.5 rounded-xl font-semibold flex items-center justify-center space-x-2 border border-blue-200 transition-all text-xs"
                    >
                      <FileDown className="w-4 h-4 text-blue-600" />
                      <span>Salin File (.txt)</span>
                    </button>
                  </div>
                </div>

              </div>

            </div>

          </div>
        )}

      </main>

      {/* MODAL BROSUR NASABAH (PRINT PREVIEW) */}
      {showBrosurModal && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-white rounded-3xl max-w-2xl w-full p-8 shadow-2xl relative border border-slate-100">
            <button
              onClick={() => setShowBrosurModal(false)}
              className="absolute top-5 right-5 p-2 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100"
            >
              <X className="w-6 h-6" />
            </button>

            <div id="printable-brosur" className="space-y-6">
              <div className="flex items-center justify-between border-b border-slate-200 pb-4">
                <div className="flex items-center space-x-3">
                  <div className="bg-blue-600 text-white p-3 rounded-2xl">
                    <Building2 className="w-7 h-7" />
                  </div>
                  <div>
                    <h2 className="text-xl font-extrabold text-slate-900">BROSUR ESTIMASI SUKU BUNGA</h2>
                    <p className="text-xs text-slate-500 font-semibold">Produk: {selectedProduct} | Penawaran Resmi Pinjaman Usaha</p>
                  </div>
                </div>
              </div>

              <div className="bg-slate-50 p-4 rounded-2xl border border-slate-200 grid grid-cols-3 gap-4 text-center">
                <div>
                  <span className="text-[11px] font-semibold text-slate-500 block uppercase">Plafon Pinjaman</span>
                  <span className="text-lg font-black text-slate-900">{formatRp(plafon)}</span>
                </div>
                <div>
                  <span className="text-[11px] font-semibold text-slate-500 block uppercase">Jangka Waktu</span>
                  <span className="text-lg font-black text-slate-900">{tenor} Bulan</span>
                </div>
                <div>
                  <span className="text-[11px] font-semibold text-slate-500 block uppercase">Bunga Efektif</span>
                  <span className="text-lg font-black text-blue-700">{bungaEfektifBulan}% / bln</span>
                </div>
              </div>

              <div className="border border-emerald-200 bg-emerald-50/50 p-5 rounded-2xl flex items-center justify-between">
                <div>
                  <span className="text-xs font-bold text-emerald-800 uppercase tracking-wider block">Setara Bunga Flat Equivalent</span>
                  <span className="text-3xl font-black text-emerald-700">{calculationResults.bungaFlatBulan}% <span className="text-xs font-normal text-slate-600">/ bulan</span></span>
                </div>
                <div className="text-right">
                  <span className="text-xs font-semibold text-slate-500 block">Estimasi Angsuran Flat:</span>
                  <span className="text-xl font-black text-slate-900">{formatRp(calculationResults.angsuranFlat)} <span className="text-xs font-normal text-slate-500">/ bln</span></span>
                </div>
              </div>

              <div className="text-[11px] text-slate-400 border-t border-slate-100 pt-3 flex justify-between items-center">
                <span>*Perhitungan di atas merupakan estimasi brosur indikatif.</span>
                <span>Dicetak pada: {new Date().toLocaleDateString('id-ID')}</span>
              </div>
            </div>

            <div className="mt-6 flex justify-end space-x-3 pt-4 border-t border-slate-100">
              <button
                onClick={() => window.print()}
                className="bg-blue-600 hover:bg-blue-700 text-white px-5 py-2.5 rounded-xl font-bold flex items-center space-x-2 text-xs shadow-sm"
              >
                <Printer className="w-4 h-4" />
                <span>Cetak Brosur Ini</span>
              </button>
            </div>
          </div>
        </div>
      )}

      {/* MODAL ADD / EDIT PIPELINE NASABAH */}
      {isModalOpen && (
        <div className="fixed inset-0 z-50 bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-white rounded-3xl max-w-lg w-full p-6 shadow-2xl relative border border-slate-100">
            <button
              onClick={handleCloseModal}
              className="absolute top-5 right-5 p-2 rounded-full text-slate-400 hover:text-slate-700 hover:bg-slate-100"
            >
              <X className="w-5 h-5" />
            </button>

            <h3 className="text-lg font-bold text-slate-900 mb-4">
              {currentEditId ? 'Edit Data Pipeline Nasabah' : 'Tambah Application Pipeline'}
            </h3>

            <form onSubmit={handleSave} className="space-y-4 text-xs">
              <div>
                <label className="block font-semibold text-slate-700 mb-1">Nama Nasabah</label>
                <input
                  type="text"
                  required
                  value={formData.nama}
                  onChange={(e) => setFormData({ ...formData, nama: e.target.value })}
                  className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800"
                  placeholder="Masukkan nama lengkap"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-semibold text-slate-700 mb-1">Produk Pinjaman</label>
                  <select
                    value={formData.produk}
                    onChange={(e) => setFormData({ ...formData, produk: e.target.value })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-bold text-slate-800"
                  >
                    <option value="KUM">KUM</option>
                    <option value="KUR">KUR</option>
                    <option value="Kawan Lawa">Kawan Lawa</option>
                  </select>
                </div>

                <div>
                  <label className="block font-semibold text-slate-700 mb-1">Bulan Pengajuan</label>
                  <select
                    value={formData.bulan}
                    onChange={(e) => setFormData({ ...formData, bulan: e.target.value })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800"
                  >
                    {['Jan', 'Feb', 'Mar', 'Apr', 'Mei', 'Jun'].map((m) => (
                      <option key={m} value={m}>{m}</option>
                    ))}
                  </select>
                </div>
              </div>

              <div>
                <label className="block font-semibold text-slate-700 mb-1">Jenis Usaha</label>
                <input
                  type="text"
                  required
                  value={formData.usaha}
                  onChange={(e) => setFormData({ ...formData, usaha: e.target.value })}
                  className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800"
                  placeholder="Contoh: Perkebunan Sawit / Toko Sembako"
                />
              </div>

              <div>
                <label className="block font-semibold text-slate-700 mb-1">Alamat Nasabah</label>
                <input
                  type="text"
                  value={formData.alamat}
                  onChange={(e) => setFormData({ ...formData, alamat: e.target.value })}
                  className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800"
                  placeholder="Masukkan alamat domisili/lokasi usaha"
                />
              </div>

              <div className="grid grid-cols-2 gap-3">
                <div>
                  <label className="block font-semibold text-slate-700 mb-1">Limit Pinjaman (Rp)</label>
                  <input
                    type="number"
                    required
                    min="1000000"
                    value={formData.limit}
                    onChange={(e) => setFormData({ ...formData, limit: e.target.value })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-bold text-blue-900"
                    placeholder="Nominal Plafon"
                  />
                </div>

                <div>
                  <label className="block font-semibold text-slate-700 mb-1">Tenor (Bulan)</label>
                  <select
                    value={formData.tenor}
                    onChange={(e) => setFormData({ ...formData, tenor: Number(e.target.value) })}
                    className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800"
                  >
                    {[6, 12, 18, 24, 36, 48, 60].map((t) => (
                      <option key={t} value={t}>{t} Bulan</option>
                    ))}
                  </select>
                </div>
              </div>

              <div>
                <label className="block font-semibold text-slate-700 mb-1">Catatan Status Pengajuan</label>
                <input
                  type="text"
                  value={formData.status}
                  onChange={(e) => setFormData({ ...formData, status: e.target.value })}
                  className="w-full p-2.5 bg-slate-50 border border-slate-300 rounded-xl font-semibold text-slate-800"
                  placeholder="Isi catatan manual (contoh: Menunggu SLIK / ACC Komite)"
                />
              </div>

              <div className="pt-4 flex justify-end space-x-2">
                <button
                  type="button"
                  onClick={handleCloseModal}
                  className="px-4 py-2 rounded-xl text-slate-600 bg-slate-100 hover:bg-slate-200 font-semibold"
                >
                  Batal
                </button>
                <button
                  type="submit"
                  className="px-5 py-2 rounded-xl text-white bg-blue-600 hover:bg-blue-700 font-bold shadow-sm"
                >
                  Simpan Data
                </button>
              </div>
            </form>
          </div>
        </div>
      )}

    </div>
  );
}