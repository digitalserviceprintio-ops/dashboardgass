                        </label>
                      </div>
                      <div className="relative rounded-xl shadow-sm">
                        <input
                          type="number"
                          step="0.01"
                          min="0.1"
                          max="10"
                          value={bungaEfektifBulan}
                          onChange={(e) => setBungaEfektifBulan(Number(e.target.value))}
                          className="block w-full pl-4 pr-10 py-3 bg-slate-50 border border-slate-300 rounded-xl focus:ring-2 focus:ring-blue-500 font-semibold text-slate-800 text-lg transition-all"
