                      <span className="text-[11px] text-slate-500 font-medium block flex items-center justify-between">
                        <span>Hasil Kalkulasi DBR</span>
                        <span className="text-[9px] font-bold">Limit 35%</span>
                      </span>
                      <div className="flex items-center justify-between mt-0.5">
                        <span className={`text-sm font-black ${memoCalculations.isDbrExceeded ? 'text-rose-700' : 'text-blue-900'}`}>
                          {memoCalculations.dbrPercent}%
