                    <span className="text-xs uppercase tracking-wider font-semibold bg-blue-50 text-blue-700 border border-blue-200 px-2.5 py-1 rounded-md">
                      Efektif ({selectedProduct})
                    </span>
                    <div className="mt-4">
                      <div className="text-3xl font-extrabold text-blue-900">{bungaEfektifBulan}% <span className="text-xs font-normal text-slate-500">/ bulan</span></div>
                    </div>
                    <div className="mt-6 pt-4 border-t border-slate-100 space-y-2">
                      <div className="flex justify-between items-center text-sm">
                        <span className="text-slate-600">Angsuran / Bln:</span>
                        <span className="font-bold text-base text-blue-900">{formatRp(calculationResults.angsuranEfektif)}</span>
                      </div>
                    </div>
                  </div>

                  <div className="bg-white border border-emerald-200 text-slate-800 rounded-2xl p-5 shadow-sm relative overflow-hidden">
                    <span className="text-xs uppercase tracking-wider font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200 px-2.5 py-1 rounded-md">
                      Setara Bunga Flat (Equivalent)
                    </span>
                    <div className="mt-4">
                      <div className="text-3xl font-extrabold text-emerald-700">{calculationResults.bungaFlatBulan}% <span className="text-xs font-normal text-slate-500">/ bulan</span></div>
                    </div>
                    <div className="mt-6 pt-4 border-t border-slate-100 space-y-2">
                      <div className="flex justify-between items-center text-sm">
